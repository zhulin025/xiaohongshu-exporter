{
  "manifest_version": 3,
  "name": "小红书收藏夹导出助手",
  "version": "1.6.3",
  "description": "导出小红书收藏夹到飞书、Notion和本地,支持JSON、CSV、HTML等多种格式",
  "author": "Leo Zhu <zhulin025@gmail.com>",
  "homepage_url": "https://github.com/zhulin025/",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://edith.xiaohongshu.com/*",
    "https://open.feishu.cn/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
